# ==============================================================================
# ResolveIQ Backend Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure values before starting the backend server.
# NEVER commit the actual .env file or sensitive secrets to source control.

# Server Network Settings
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas or local daemon)
# Example Atlas format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/resolveiq?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resolveiq

# Security & Authentication Secrets
# Generate a secure 64-character hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_min_32_chars_do_not_share

# Google Gemini API (Backend Only - Optional for initial phases)
# Obtain from Google AI Studio: https://aistudio.google.com/
# Leave blank to run 100% in deterministic offline fallback mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
